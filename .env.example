# Application
NODE_ENV=development
PORT=3000
APP_URL=https://your-app.ngrok.io

# Shopify Configuration
# Get these from your Shopify Partner Dashboard: https://partners.shopify.com
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_SCOPES=read_orders,read_customers,read_products,read_analytics
SHOPIFY_APP_URL=https://your-app.ngrok.io

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=shopify_app
DB_PASSWORD=your_secure_password_here
DB_NAME=shopify_attribution
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT=10000

# Security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_256_bit_encryption_key_here_64_chars_hex
SESSION_SECRET=your_session_secret_here_minimum_32_chars
WEBHOOK_SECRET=your_webhook_secret_here

# Rate Limiting (Shopify GraphQL bucket parameters)
RATE_LIMIT_MAX_TOKENS=1000
RATE_LIMIT_REFILL_RATE=50
RATE_LIMIT_MIN_THRESHOLD=100

# Queue Configuration
WEBHOOK_QUEUE_CONCURRENCY=5
SYNC_QUEUE_CONCURRENCY=2
WEBHOOK_RETRY_MAX_ATTEMPTS=3

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_MAX_FILES=14d

# API Configuration
API_REQUEST_TIMEOUT=30000
API_MAX_RETRIES=3

# Monitoring (Optional)
SENTRY_DSN=
DATADOG_API_KEY=
